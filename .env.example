# Port the server listens on (most hosts set this for you)
PORT=3000
# Local SQLite file, used when TURSO_DATABASE_URL is empty (dev, or a host with a persistent disk)
DATABASE_PATH=data/promptvault.db
# Turso (hosted SQLite): required on Vercel and other hosts without a persistent disk.
#   turso db create promptvault && turso db show promptvault --url && turso db tokens create promptvault
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set to 1 when running behind a reverse proxy / PaaS so rate limiting sees real client IPs
TRUST_PROXY=0
# Extra origins allowed to sign in / change data, comma-separated (only needed if a proxy hides the real host)
# ALLOWED_ORIGINS=https://promptvault.example.com

# --- Post analyzer (browser extension backend) --------------------------------
# API origin baked into the downloadable extension (dist/promptvault-extension.zip).
# On Vercel it defaults to https://$VERCEL_PROJECT_PRODUCTION_URL; set it for a custom domain or other hosts.
# EXTENSION_API_BASE=https://promptvault.example.com
# Optional bearer token so scripts (curl) can call /api/admin/* without an account
ADMIN_TOKEN=
# Speech-to-text for reel audio via whisper.cpp. STT is off unless both are set.
# Use a small model in production (ggml-base.bin / ggml-small.bin); large-v3 is ~10x slower on CPU.
WHISPER_BIN=
WHISPER_MODEL=
WHISPER_LANGUAGE=auto
WHISPER_THREADS=4
FFMPEG_BIN=ffmpeg

# --- Accounts ------------------------------------------------------------------
# HS256 signing key for access tokens, 32+ random chars. REQUIRED in production:
#   openssl rand -base64 48
JWT_SECRET=
# Comma-separated emails that get the admin role (Admin tab: submitted links + extension analyses)
ADMIN_EMAILS=
